{
  "name": "l10n-generator",
  "version": "0.3.0",
  "description": "Generate localization files (Dart ARB, TypeScript) from CSV, xlsx or Google Sheets",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "formatcheck": "prettier --check \"src/**/*.(js|ts)\"",
    "lint": "eslint . --config eslint.config.js --cache",
    "lint:fix": "eslint . --config eslint.config.js --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:sheets": "./test-sheets.sh",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm lint",
    "preversion": "pnpm lint",
    "version": "pnpm format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueki-tomohiro/l10n-generator.git"
  },
  "keywords": [
    "l10n",
    "i18n",
    "localization",
    "internationalization",
    "dart",
    "typescript",
    "arb",
    "google-sheets"
  ],
  "bin": "./lib/cli.js",
  "author": "Tomohiro Ueki",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ueki-tomohiro/l10n-generator/issues"
  },
  "homepage": "https://github.com/ueki-tomohiro/l10n-generator#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.0.0",
    "js-yaml": "^4.3.2",
    "lodash": "^4.17.23",
    "node-fetch": "^2.7.0",
    "open": "^8.4.2",
    "xlsx": "^0.18.5",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.23",
    "@types/node-fetch": "^2.6.13",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "debug": "^4.4.3",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "files": [
    "lib/**/*"
  ],
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@>=6 <7": "^6.14.0",
      "brace-expansion@>=1 <2": "^1.1.18",
      "brace-expansion@>=2 <3": "^2.1.4",
      "fflate@>=0.8 <0.9": "^0.8.3",
      "flatted@>=3 <4": "^3.4.2",
      "form-data@>=4 <5": "^4.0.6",
      "minimatch@>=3 <4": "^3.1.4",
      "minimatch@>=9 <10": "^9.0.7",
      "nanoid@>=3 <4": "^3.3.18",
      "picomatch@>=2 <3": "^2.3.2",
      "picomatch@>=4 <5": "^4.0.4",
      "postcss@>=8 <9": "^8.5.23",
      "qs@>=6 <7": "^6.16.0",
      "rollup@>=4 <5": "^4.59.0"
    }
  }
}
